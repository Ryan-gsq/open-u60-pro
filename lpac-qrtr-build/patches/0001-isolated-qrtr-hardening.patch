+/* Reject implicit defaults, signs, whitespace, partial parses and overflow. */
+static int explicit_uint(const char *name, unsigned long min, unsigned long max, unsigned long *out) {
+    const char *s = getenv(name);
+    if (!s || !*s) goto invalid;
+    for (const char *p = s; *p; p++)
+        if (*p < '0' || *p > '9') goto invalid;
+    errno = 0;
+    char *end;
+    unsigned long n = strtoul(s, &end, 10);
+    if (errno || *end || n < min || n > max) goto invalid;
+    *out = n;
+    return 0;
+invalid:
+    fprintf(stderr, "error: explicit %s required in range %lu..%lu; no default selected\n", name, min, max);
+    return -1;
+}
